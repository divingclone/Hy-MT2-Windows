+// Hy-MT normalizes after RoPE. Keep the rotated values in registers until normalization.
+template <typename D, bool strict_reduction>
+static __global__ void hymt_rope_norm_128_f32(
+        const float * x, D * dst, const float * weight, const int32_t * pos,
+        const int nheads, const int ntokens, const int64_t stride_head, const int64_t stride_token,
+        const float eps, const float theta_scale, const float freq_scale,
+        const float ext_factor, const float attn_factor, const rope_corr_dims corr_dims,
+        const int64_t * row_indices, const int64_t set_rows_stride) {
+    ggml_cuda_pdl_lc();
+    const int lane = threadIdx.x % 32;
+    const int row = blockIdx.x * (blockDim.x / 32) + threadIdx.x / 32;
+    if (row >= nheads * ntokens) {
+        return;
+    }
+    const int token = row / nheads;
+    const int head = row % nheads;
+    x += head * stride_head + token * stride_token;
+
+    ggml_cuda_pdl_sync();
+    float rotated[4];
+#pragma unroll
+    for (int pair = 0; pair < 2; ++pair) {
+        const int col = lane + 32 * pair;
+        const float theta = pos[token] * powf(theta_scale, float(col));
+        float cos_theta;
+        float sin_theta;
+        rope_yarn<true>(theta, freq_scale, corr_dims, 2 * col, ext_factor, attn_factor, cos_theta, sin_theta);
+        const float x0 = x[col];
+        const float x1 = x[col + 64];
+        rotated[pair] = x0 * cos_theta - x1 * sin_theta;
+        rotated[pair + 2] = x0 * sin_theta + x1 * cos_theta;
+    }
+
+    float sum;
+    if constexpr (strict_reduction) {
+        // Match rms_norm_f32<256>: four active warps each square and reduce
+        // 32 consecutive columns, followed by a warp reduction of their lane-0
+        // sums (the remaining four warps contribute zero). Keep the squares
+        // rounded separately, as in the original one-column-per-thread kernel.
+        float warp_sums[4];
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            const float partial = warp_reduce_sum<32>(__fmul_rn(rotated[i], rotated[i]));
+            warp_sums[i] = __shfl_sync(0xffffffff, partial, 0);
+        }
+        const float partial = lane == 0 ? warp_sums[0] : lane == 1 ? warp_sums[1] :
+                              lane == 2 ? warp_sums[2] : lane == 3 ? warp_sums[3] : 0.0f;
+        sum = warp_reduce_sum<32>(partial);
+    } else {
+        float partial = 0.0f;
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            partial += rotated[i] * rotated[i];
+        }
+        sum = warp_reduce_sum<32>(partial);
+    }
+    const float scale = rsqrtf(sum * (1.0f / 128.0f) + eps);
+    const int64_t dst_row = row_indices == nullptr ? int64_t(row) * 128 :
+        row_indices[token] * set_rows_stride + head * 128;
+    dst += dst_row;
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        const int col = lane + 32 * i;
+        dst[col] = ggml_cuda_cast<D>(scale * rotated[i] * weight[col]);
+    }
+}
