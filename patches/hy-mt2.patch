+++ b/tools/hy-logits/hy-logits.cpp
@@ -0,0 +1,354 @@
+#if defined(_WIN32)
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#endif
+
+#include "common.h"
+#include "json.h"
+#include "llama-cpp.h"
+#include "llama.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+
+struct options {
+    std::string model, text_file, tokens_file, output, reference, candidate;
+    int limit = 96, batch = 1, parallel = 1, context = 2048, threads = 8, gpu_layers = 99;
+    bool last_only = false, flash_attn = true;
+};
+
+struct batch_guard {
+    llama_batch value;
+    explicit batch_guard(int capacity) : value(llama_batch_init(capacity, 0, 1)) {}
+    ~batch_guard() { llama_batch_free(value); }
+};
+
+static std::string read_text(const std::string & path) {
+    std::ifstream file(std::filesystem::u8path(path), std::ios::binary);
+    if (!file) { throw std::runtime_error("cannot open " + path); }
+    return std::string(std::istreambuf_iterator<char>(file), {});
+}
+
+static common_json read_json(const std::string & path) {
+    return common_json::parse(read_text(path));
+}
+
+static void write_json(const std::string & path, const common_json & value) {
+    const auto file_path = std::filesystem::u8path(path);
+    if (file_path.has_parent_path()) { std::filesystem::create_directories(file_path.parent_path()); }
+    std::ofstream file(file_path, std::ios::binary);
+    if (!file || !(file << value.dump(2) << '\n')) { throw std::runtime_error("cannot write " + path); }
+}
+
+static std::string prefix(std::string path) {
+    if (path.size() >= 5 && path.substr(path.size() - 5) == ".json") { path.resize(path.size() - 5); }
+    return path;
+}
+
+static int positive(const std::string & text, const std::string & flag) {
+    size_t end = 0;
+    const long long result = std::stoll(text, &end);
+    if (end != text.size() || result < 1 || result > 1000000) { throw std::runtime_error("invalid " + flag); }
+    return static_cast<int>(result);
+}
+
+static options parse(int argc, char ** argv) {
+    options opt;
+    for (int i = 1; i < argc; ++i) {
+        const std::string arg = argv[i];
+        const auto next = [&]() -> std::string {
+            if (++i == argc) { throw std::runtime_error("missing value for " + arg); }
+            return argv[i];
+        };
+        if (arg == "--model" || arg == "-m") { opt.model = next(); }
+        else if (arg == "--text-file") { opt.text_file = next(); }
+        else if (arg == "--tokens") { opt.tokens_file = next(); }
+        else if (arg == "--output" || arg == "-o") { opt.output = next(); }
+        else if (arg == "--limit") { opt.limit = positive(next(), arg); }
+        else if (arg == "--batch") { opt.batch = positive(next(), arg); }
+        else if (arg == "--parallel") { opt.parallel = positive(next(), arg); }
+        else if (arg == "--context") { opt.context = positive(next(), arg); }
+        else if (arg == "--threads") { opt.threads = positive(next(), arg); }
+        else if (arg == "--gpu-layers") {
+            const auto value = next();
+            opt.gpu_layers = value == "0" ? 0 : positive(value, arg);
+        }
+        else if (arg == "--last-only") { opt.last_only = true; }
+        else if (arg == "--no-flash-attn") { opt.flash_attn = false; }
+        else if (arg == "--compare") { opt.reference = prefix(next()); opt.candidate = prefix(next()); }
+        else if (arg == "--help" || arg == "-h") {
+            std::cout << "Teacher-forced logits dump; no sampling or generated-token feedback.\n"
+                "hy-logits -m MODEL -o PREFIX [--text-file UTF8 | --tokens JSON] [--limit 96]\n"
+                "          [--batch 1] [--parallel 1] [--context 2048] [--threads 8]\n"
+                "          [--gpu-layers 99] [--last-only] [--no-flash-attn]\n"
+                "hy-logits --compare REFERENCE_PREFIX CANDIDATE_PREFIX [-o REPORT.json]\n"
+                "Writes PREFIX.json and PREFIX.f32 (native little-endian float32).\n"
+                "--tokens accepts an integer array or a prior dump JSON with tokens.\n"
+                "--parallel duplicates the fixed sequence across slots; dumps slot 0.\n"
+                "--batch counts tokens per slot per decode, default 1 tests decode.\n"
+                "Comparison reports differences without an arbitrary pass threshold.\n";
+            std::exit(0);
+        } else { throw std::runtime_error("unknown argument " + arg); }
+    }
+    if (opt.reference.empty() && (opt.model.empty() || opt.output.empty())) {
+        throw std::runtime_error("dump mode requires --model and --output");
+    }
+    if (!opt.text_file.empty() && !opt.tokens_file.empty()) { throw std::runtime_error("choose --text-file or --tokens"); }
+    if (opt.context < opt.limit || int64_t(opt.context) * opt.parallel > std::numeric_limits<int32_t>::max() ||
+        int64_t(opt.batch) * opt.parallel > std::numeric_limits<int32_t>::max()) {
+        throw std::runtime_error("invalid context/limit/batch/parallel product");
+    }
+    return opt;
+}
+
+static common_json environment() {
+    common_json result = common_json::object();
+    for (const auto * key : {"LLAMA_HYMT_FUSED_PROJ", "GGML_CUDA_HYMT_DISABLE_ROPE_NORM",
+            "GGML_CUDA_HYMT_ROPE_NORM_STRICT",
+            "GGML_CUDA_HYMT_DISABLE_TOPK", "LLAMA_HYMT_SPARSE_PENALTIES", "LLAMA_HYMT_SAMPLING_SNAPSHOT",
+            "GGML_CUDA_HYMT_EAGER_GRAPHS", "GGML_CUDA_DISABLE_GRAPHS", "GGML_CUDA_GRAPH_OPT", "GGML_CUDA_FORCE_MMQ"}) {
+        const auto * value = std::getenv(key);
+        result[key] = value ? common_json(value) : common_json(nullptr);
+    }
+    return result;
+}
+
+static int dump_logits(const options & opt) {
+    common_init();
+    llama_backend_init();
+    struct backend_guard { ~backend_guard() { llama_backend_free(); } } guard;
+    auto mp = llama_model_default_params();
+    mp.n_gpu_layers = opt.gpu_layers;
+    llama_model_ptr model(llama_model_load_from_file(opt.model.c_str(), mp));
+    if (!model) { throw std::runtime_error("model load failed"); }
+    const auto * vocab = llama_model_get_vocab(model.get());
+    const int n_vocab = llama_vocab_n_tokens(vocab);
+    std::vector<llama_token> tokens;
+    if (!opt.tokens_file.empty()) {
+        const auto data = read_json(opt.tokens_file);
+        const auto & values = data.is_array() ? data : data.at("tokens");
+        for (const auto & item : values) {
+            if (!item.is_number_integer()) { throw std::runtime_error("token IDs must be integers"); }
+            const int64_t token = item.get<int64_t>();
+            if (token < 0 || token >= n_vocab) { throw std::runtime_error("token ID outside vocabulary"); }
+            tokens.push_back(static_cast<llama_token>(token));
+        }
+    } else {
+        const std::string text = opt.text_file.empty() ?
+            "Translate the following segment into Chinese, without additional explanation.\n\n"
+            "The engineering team inspected the bridge after a week of heavy rain. Although the main structure "
+            "remained stable, two sensors reported unusual vibration near the eastern support. Before reopening "
+            "the road, the team replaced the damaged cable, checked the calibration records, and compared the "
+            "new measurements with last year's inspection. The project manager asked everyone to document "
+            "their findings clearly, including the time, location, equipment settings, and any uncertainty. "
+            "A final report will explain the repair work and recommend a schedule for future maintenance. "
+            "Residents can use the temporary bus service until the safety inspection has been completed." : read_text(opt.text_file);
+        tokens = common_tokenize(vocab, text, true, true);
+    }
+    if (tokens.size() > size_t(opt.limit)) { tokens.resize(opt.limit); }
+    if (tokens.empty()) { throw std::runtime_error("empty token sequence"); }
+    auto cp = llama_context_default_params();
+    cp.n_ctx = uint32_t(opt.context) * opt.parallel;
+    cp.n_batch = uint32_t(opt.batch) * opt.parallel;
+    cp.n_ubatch = cp.n_batch;
+    cp.n_seq_max = opt.parallel;
+    cp.n_threads = cp.n_threads_batch = opt.threads;
+    cp.flash_attn_type = opt.flash_attn ? LLAMA_FLASH_ATTN_TYPE_ENABLED : LLAMA_FLASH_ATTN_TYPE_DISABLED;
+    cp.no_perf = true;
+    cp.kv_unified = false;
+    llama_context_ptr ctx(llama_init_from_model(model.get(), cp));
+    if (!ctx) { throw std::runtime_error("context initialization failed"); }
+    const auto out = prefix(opt.output);
+    const auto path = std::filesystem::u8path(out + ".f32");
+    if (path.has_parent_path()) { std::filesystem::create_directories(path.parent_path()); }
+    std::ofstream binary(path, std::ios::binary);
+    if (!binary) { throw std::runtime_error("cannot write " + out + ".f32"); }
+    batch_guard batch(static_cast<int>(cp.n_batch));
+    std::vector<int> positions, top1;
+    uint64_t nonfinite = 0;
+    for (size_t first = 0; first < tokens.size(); first += opt.batch) {
+        const size_t count = std::min(size_t(opt.batch), tokens.size() - first);
+        batch.value.n_tokens = int(count) * opt.parallel;
+        for (size_t i = 0; i < count; ++i) {
+            for (int seq = 0; seq < opt.parallel; ++seq) {
+                const int index = int(i) * opt.parallel + seq;
+                batch.value.token[index] = tokens[first + i];
+                batch.value.pos[index] = static_cast<llama_pos>(first + i);
+                batch.value.n_seq_id[index] = 1;
+                batch.value.seq_id[index][0] = seq;
+                batch.value.logits[index] = true;
+            }
+        }
+        if (llama_decode(ctx.get(), batch.value) != 0) { throw std::runtime_error("decode failed"); }
+        // All rows were requested, so packed logits are in batch order after this accessor synchronizes.
+        const float * logits = llama_get_logits(ctx.get());
+        if (!logits) { throw std::runtime_error("missing logits"); }
+        for (size_t i = 0; i < count; ++i) {
+            if (opt.last_only && first + i + 1 != tokens.size()) { continue; }
+            const float * row = logits + i * opt.parallel * n_vocab;
+            binary.write(reinterpret_cast<const char *>(row), std::streamsize(n_vocab) * sizeof(float));
+            if (!binary) { throw std::runtime_error("logits write failed"); }
+            positions.push_back(static_cast<int>(first + i));
+            top1.push_back(static_cast<int>(std::max_element(row, row + n_vocab) - row));
+            for (int j = 0; j < n_vocab; ++j) { nonfinite += !std::isfinite(row[j]); }
+        }
+    }
+    binary.close();
+    if (!binary) { throw std::runtime_error("logits close failed"); }
+    common_json metadata = {
+        {"format", "hy-logits-v1"}, {"dtype", "float32-le"}, {"model", opt.model},
+        {"binary", path.filename().u8string()}, {"n_vocab", n_vocab}, {"tokens", tokens},
+        {"positions", positions}, {"top1", top1}, {"nonfinite_values", nonfinite},
+        {"teacher_forced", true}, {"sampled_tokens_used", false}, {"recorded_sequence", 0},
+        {"batch_per_sequence", opt.batch}, {"parallel", opt.parallel}, {"context_per_sequence", opt.context},
+        {"threads", opt.threads}, {"gpu_layers", opt.gpu_layers}, {"flash_attn", opt.flash_attn},
+        {"environment", environment()}
+    };
+    write_json(out + ".json", metadata);
+    std::cout << "Saved " << positions.size() << " rows x " << n_vocab << " logits to " << out
+              << "; nonfinite=" << nonfinite << '\n';
+    return nonfinite ? 2 : 0;
+}
+
+struct row_summary {
+    int best = -1;
+    double margin = 0;
+};
+
+static row_summary summarize(const std::vector<float> & row) {
+    float first = -std::numeric_limits<float>::infinity();
+    float second = first;
+    row_summary result;
+    for (int i = 0; i < int(row.size()); ++i) {
+        if (!std::isfinite(row[i])) { continue; }
+        if (row[i] > first) { second = first; first = row[i]; result.best = i; }
+        else if (row[i] > second) { second = row[i]; }
+    }
+    result.margin = double(first) - second;
+    return result;
+}
+
+static int compare_logits(const options & opt) {
+    const auto ref = read_json(opt.reference + ".json");
+    const auto cand = read_json(opt.candidate + ".json");
+    for (const auto * key : {"format", "dtype", "n_vocab", "tokens", "positions"}) {
+        if (ref.at(key) != cand.at(key)) { throw std::runtime_error(std::string("incompatible dumps: ") + key); }
+    }
+    if (ref.at("format") != "hy-logits-v1" || ref.at("dtype") != "float32-le") {
+        throw std::runtime_error("unsupported dump format");
+    }
+    const int n_vocab = ref.at("n_vocab").get<int>();
+    const auto positions = ref.at("positions").get<std::vector<int>>();
+    if (n_vocab < 2 || positions.empty()) { throw std::runtime_error("empty dump dimensions"); }
+    const uint64_t expected = uint64_t(positions.size()) * n_vocab * sizeof(float);
+    const auto path_a = std::filesystem::u8path(opt.reference + ".f32");
+    const auto path_b = std::filesystem::u8path(opt.candidate + ".f32");
+    if (std::filesystem::file_size(path_a) != expected || std::filesystem::file_size(path_b) != expected) {
+        throw std::runtime_error("binary length does not match metadata");
+    }
+    std::ifstream file_a(path_a, std::ios::binary), file_b(path_b, std::ios::binary);
+    std::vector<float> a(n_vocab), b(n_vocab);
+    common_json rows = common_json::array();
+    double max_abs = 0, total_squared = 0, total_abs = 0;
+    uint64_t nonfinite = 0, identical = 0, finite_pairs = 0;
+    int top1_matches = 0, worst_position = -1, worst_token = -1;
+    for (const int position : positions) {
+        file_a.read(reinterpret_cast<char *>(a.data()), std::streamsize(n_vocab) * sizeof(float));
+        file_b.read(reinterpret_cast<char *>(b.data()), std::streamsize(n_vocab) * sizeof(float));
+        if (!file_a || !file_b) { throw std::runtime_error("binary read failed"); }
+        double row_max = 0, row_squared = 0;
+        uint64_t row_finite = 0, row_nonfinite = 0;
+        for (int j = 0; j < n_vocab; ++j) {
+            if (!std::isfinite(a[j]) || !std::isfinite(b[j])) { ++nonfinite; ++row_nonfinite; continue; }
+            ++finite_pairs; ++row_finite;
+            identical += a[j] == b[j];
+            const double delta = std::abs(double(a[j]) - b[j]);
+            row_max = std::max(row_max, delta);
+            row_squared += delta * delta;
+            total_abs += delta;
+            if (delta > max_abs) { max_abs = delta; worst_position = position; worst_token = j; }
+        }
+        total_squared += row_squared;
+        const auto sa = summarize(a), sb = summarize(b);
+        const bool match = sa.best >= 0 && sa.best == sb.best;
+        top1_matches += match;
+        rows.push_back({{"position", position}, {"max_abs", row_max},
+            {"rmse", row_finite ? common_json(std::sqrt(row_squared / row_finite)) : common_json(nullptr)},
+            {"reference_top1", sa.best}, {"candidate_top1", sb.best}, {"top1_match", match},
+            {"reference_top1_margin", sa.margin}, {"candidate_top1_margin", sb.margin},
+            {"nonfinite_pairs", row_nonfinite}});
+    }
+    common_json report = {
+        {"reference", opt.reference}, {"candidate", opt.candidate}, {"rows", positions.size()},
+        {"n_vocab", n_vocab}, {"max_abs", max_abs},
+        {"rmse", finite_pairs ? common_json(std::sqrt(total_squared / finite_pairs)) : common_json(nullptr)},
+        {"mean_abs", finite_pairs ? common_json(total_abs / finite_pairs) : common_json(nullptr)},
+        {"identical_finite_values", identical}, {"finite_pairs", finite_pairs}, {"nonfinite_pairs", nonfinite},
+        {"top1_matches", top1_matches}, {"top1_match_rate", double(top1_matches) / positions.size()},
+        {"worst_position", worst_position}, {"worst_token_id", worst_token},
+        {"reference_config", ref}, {"candidate_config", cand}, {"per_position", rows},
+        {"note", "No automatic tolerance. Inspect logit error and top1 margins; translation differences alone do not prove correctness."}
+    };
+    if (!opt.output.empty()) { write_json(opt.output, report); }
+    std::cout << report.dump(2) << '\n';
+    return nonfinite ? 2 : 0;
+}
+
+} // namespace
+
+static int main_utf8(int argc, char ** argv) {
+    try {
+        const auto opt = parse(argc, argv);
+        return opt.reference.empty() ? dump_logits(opt) : compare_logits(opt);
+    } catch (const std::exception & e) {
+        std::cerr << "hy-logits: " << e.what() << '\n';
+        return 1;
+    }
+}
+
+#if defined(_WIN32)
+int wmain(int argc, wchar_t ** argv) {
+    try {
+        std::vector<std::string> arguments;
+        arguments.reserve(argc);
+        for (int i = 0; i < argc; ++i) {
+            const int size = WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, argv[i], -1, nullptr, 0, nullptr, nullptr);
+            if (size == 0) throw std::runtime_error("invalid Unicode command-line argument");
+            std::string argument(size, '\0');
+            if (WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, argv[i], -1, argument.data(), size, nullptr, nullptr) != size) {
+                throw std::runtime_error("could not convert command-line argument to UTF-8");
+            }
+            argument.pop_back(); // WideCharToMultiByte included the terminating NUL.
+            arguments.push_back(std::move(argument));
+        }
+        std::vector<char *> pointers;
+        pointers.reserve(size_t(argc) + 1);
+        for (auto & argument : arguments) pointers.push_back(argument.data());
+        pointers.push_back(nullptr);
+        return main_utf8(argc, pointers.data());
+    } catch (const std::exception & error) {
+        std::cerr << "hy-logits: " << error.what() << '\n';
+        return 1;
+    }
+}
+#else
+int main(int argc, char ** argv) {
+    return main_utf8(argc, argv);
+}
+#endif
