+    };
+    while (true) {
+        std::vector<request> items;
+        request next_item;
+        while (items.size() < size_t(opt.parallel) && read_request(next_item)) items.push_back(std::move(next_item));
+        if (items.empty()) break;
+        ++waves;
+        // CPU samplers are not retained by the context. Backend sampling keeps
+        // all registered sampler slots alive and padded until it has a separate
+        // tested detach/rebuild path for every cached graph arena.
+        const int wave_width = opt.pad_final_wave || opt.backend_sampling || opt.gpu_prefix ? opt.parallel : int(items.size());
+        wave_widths.push_back(wave_width);
+        std::vector<slot> slots(wave_width);
+        llama_synchronize(ctx.get());
+        llama_memory_clear(llama_get_memory(ctx.get()), false);
+        std::vector<common_sampler_ptr> wave_samplers;
+        for (int i = 0; i < wave_width; ++i) {
+            auto request_sampling = sampling;
+            const uint64_t seed = i < int(items.size()) ? uint64_t(opt.seed) + started + i : opt.seed;
+            if (seed >= LLAMA_DEFAULT_SEED) throw std::runtime_error("per-request seed exceeds 4294967294");
+            request_sampling.seed = uint32_t(seed);
+            wave_samplers.emplace_back(common_sampler_init(model.get(), request_sampling));
+            if (!wave_samplers.back()) throw std::runtime_error("could not create request sampler");
+            if (opt.gpu_prefix && !common_sampler_enable_hymt_gpu_prefix(wave_samplers.back().get())) {
+                throw std::runtime_error("request sampler does not support GPU prefix");
+            }
+            if ((opt.backend_sampling || opt.gpu_prefix) && !llama_set_sampler(ctx.get(), i, common_sampler_get(wave_samplers.back().get()))) {
+                throw std::runtime_error("could not attach backend sampler");
+            }
+        }
+        // Keep old sampler objects alive until their last graph has been replaced.
+        samplers.swap(wave_samplers);
+        auto prepare_slot = [&](int i) {
+            auto & current = slots[i];
+            const auto & item = items[i];
+            common_chat_msg message;
+            message.role = "user";
+            message.content = "Translate the following text into " + item.target +
+                ". Note that you should only output the translated result without any additional explanation:\n" + item.text;
+            common_chat_templates_inputs chat_input;
+            chat_input.messages.push_back(message);
+            chat_input.add_generation_prompt = true;
+            chat_input.use_jinja = true;
+            const auto formatted = common_chat_templates_apply(templates.get(), chat_input);
+            current.prompt = common_tokenize(vocab, formatted.prompt, true, true);
+            if (current.prompt.empty() || current.prompt.size() + opt.max_tokens > size_t(opt.context)) {
+                throw std::runtime_error("prompt plus max-tokens exceeds per-sequence context for id " + item.id.dump());
+            }
+            current.active = true;
+            current.next_pos = int(current.prompt.size());
+            prompt_tokens += current.prompt.size();
+        };
+        common_batch_clear(batch);
+        for (int i = 0; i < wave_width; ++i) {
+            auto & current = slots[i];
+            if (i < int(items.size())) {
+                current.request_index = started++;
+                prepare_slot(i);
+            } else {
+                current.prompt = {eos};
+            }
+            current.next_pos = int(current.prompt.size());
+            // Keep the last prompt token for one common batch with one output per sequence.
+            for (size_t pos = 0; pos + 1 < current.prompt.size(); ++pos) {
+                common_batch_add(batch, current.prompt[pos], int(pos), {i}, false);
+                if (batch.n_tokens == opt.batch) {
+                    decode(ctx.get(), batch);
+                    common_batch_clear(batch);
+                }
+            }
+        }
+        decode(ctx.get(), batch);
+        llama_synchronize(ctx.get());
+        // Mid-prompt backend graphs can draw dummy random numbers. Restart at the request seed.
+        for (int i = 0; i < wave_width; ++i) {
+            common_sampler_reset(samplers[i].get());
+            for (const llama_token token : slots[i].prompt) {
+                common_sampler_accept(samplers[i].get(), token, false);
+            }
+        }
+        common_batch_clear(batch);
+        for (int i = 0; i < wave_width; ++i) {
+            common_batch_add(batch, slots[i].prompt.back(), slots[i].next_pos - 1, {i}, true);
+        }
+        decode(ctx.get(), batch);
+
+        int active = int(items.size());
+        std::vector<int32_t> sample_slots;
+        sample_slots.reserve(wave_width);
+        std::vector<llama_output_snapshot> snapshots(wave_width);
+        std::vector<llama_token> sampled(wave_width, eos);
+        std::vector<llama_token> next_tokens(wave_width, eos);
+        std::vector<int> finished_slots;
+        std::vector<int> fresh_slots;
+        while (active > 0) {
+            int step_width = wave_width;
+            if (prepared_snapshots) {
+                const auto snapshot_start = clock_type::now();
+                sample_slots.clear();
+                for (int i = 0; i < wave_width; ++i) {
+                    if (slots[i].active) sample_slots.push_back(i);
+                }
+                // Synchronize/reorder once, then resolve all active rows on the
+                // main thread. Snapshots are packed in sample_slots order.
+                if (batch_snapshot) {
+                    if (!llama_get_output_snapshots(ctx.get(), sample_slots.data(), int32_t(sample_slots.size()), snapshots.data())) {
+                        throw std::runtime_error("could not resolve sampler output snapshot");
+                    }
+                } else {
+                    for (size_t index = 0; index < sample_slots.size(); ++index) {
+                        if (!llama_get_output_snapshot_ith(ctx.get(), sample_slots[index], &snapshots[index])) {
+                            throw std::runtime_error("could not resolve sampler output snapshot");
+                        }
+                    }
+                }
+                snapshot_wait_s += elapsed(snapshot_start);
+                const auto sampling_start = clock_type::now();
+                pool.run(sample_slots.size(), [&](size_t index) {
+                    const int i = sample_slots[index];
+                    sampled[i] = common_sampler_sample_from_output(samplers[i].get(), snapshots[index]);
+                });
+                cpu_sampling_s += elapsed(sampling_start);
+            }
+            common_batch_clear(batch);
+            finished_slots.clear();
+            uint64_t step_dummy = 0;
+            for (int i = 0; i < wave_width; ++i) {
+                auto & current = slots[i];
+                llama_token token = eos;
+                const bool was_active = current.active;
+                if (was_active) {
+                    token = prepared_snapshots ? sampled[i] : common_sampler_sample(samplers[i].get(), ctx.get(), i);
+                    common_sampler_accept(samplers[i].get(), token, true);
+                    ++current.completion_tokens;
+                    if (llama_vocab_is_eog(vocab, token)) {
+                        current.finish_reason = "stop";
+                        current.active = false;
+                        --active;
+                    } else {
+                        current.output += common_token_to_piece(vocab, token, false);
+                        ++current.output_tokens;
+                        if (current.completion_tokens == opt.max_tokens) {
+                            current.finish_reason = "length";
+                            current.active = false;
+                            --active;
+                        }
+                    }
+                } else {
+                    ++step_dummy;
+                }
+                if (opt.continuous && was_active && !current.active) {
+                    finish_request(items[i], current);
+                    finished_slots.push_back(i);
+                }
+                next_tokens[i] = token;
+                // Dead sequences keep private EOS history; no token is shared across sequence IDs.
+                if (!opt.continuous) common_batch_add(batch, token, current.next_pos++, {i}, true);
+            }
+            if (opt.continuous) {
+                // All old snapshots have been consumed before clearing KV or running prefill.
+                for (const int i : finished_slots) {
+                    if (!llama_memory_seq_rm(llama_get_memory(ctx.get()), i, -1, -1)) {
+                        throw std::runtime_error("could not release completed sequence");
+                    }
+                    slots[i].next_pos = 0;
+                }
+                fresh_slots.clear();
+                if (!input_exhausted && (wave_width - active >= opt.refill_min || active == 0)) {
+                    const auto refill_start = clock_type::now();
+                    for (int i = 0; i < wave_width; ++i) {
+                        if (slots[i].active) continue;
+                        request replacement;
+                        if (!read_request(replacement)) break;
+                        if (!llama_memory_seq_rm(llama_get_memory(ctx.get()), i, -1, -1)) {
+                            throw std::runtime_error("could not clear reused sequence");
+                        }
+                        items[i] = std::move(replacement);
+                        slots[i] = {};
+                        slots[i].request_index = started++;
+                        const uint64_t seed = uint64_t(opt.seed) + slots[i].request_index;
+                        if (seed >= LLAMA_DEFAULT_SEED) throw std::runtime_error("per-request seed exceeds 4294967294");
+                        auto request_sampling = sampling;
+                        request_sampling.seed = uint32_t(seed);
+                        samplers[i].reset(common_sampler_init(model.get(), request_sampling));
+                        if (!samplers[i]) throw std::runtime_error("could not create refill sampler");
+                        prepare_slot(i);
+                        ++active;
+                        ++refilled_requests;
+                        fresh_slots.push_back(i);
+                        auto & current = slots[i];
+                        for (size_t pos = 0; pos + 1 < current.prompt.size(); ++pos) {
+                            common_batch_add(batch, current.prompt[pos], int(pos), {i}, false);
+                            if (batch.n_tokens == opt.batch) {
+                                decode(ctx.get(), batch);
+                                common_batch_clear(batch);
+                            }
+                        }
+                        for (const llama_token token : current.prompt) common_sampler_accept(samplers[i].get(), token, false);
+                        next_tokens[i] = current.prompt.back();
+                        --current.next_pos;
+                    }
+                    if (!fresh_slots.empty()) {
+                        ++refill_events;
+                        decode(ctx.get(), batch);
+                        llama_synchronize(ctx.get());
+                    }
+                    common_batch_clear(batch);
+                    refill_prefill_s += elapsed(refill_start);
+                }
+                if (active == 0) break;
+                if (input_exhausted) {
+                    while (step_width > 1 && !slots[step_width - 1].active) --step_width;
+                }
+                step_dummy = 0;
+                for (int i = 0; i < step_width; ++i) {
+                    auto & current = slots[i];
+                    if (!current.active) {
+                        ++step_dummy;
+                        next_tokens[i] = eos;
+                        if (current.next_pos >= opt.context) {
+                            if (!llama_memory_seq_rm(llama_get_memory(ctx.get()), i, -1, -1)) {
+                                throw std::runtime_error("could not recycle padding sequence");
+                            }
+                            current.next_pos = 0;
+                        }
+                    }
+                    common_batch_add(batch, next_tokens[i], current.next_pos++, {i}, true);
+                }
+                refill_prompt_ends += fresh_slots.size();
+            }
+            if (active == 0) break;
+            decode(ctx.get(), batch);
+            ++decode_steps;
+            ++decode_width_counts[step_width];
+            decode_tokens += step_width;
+            dummy_decode_tokens += step_dummy;
+        }
+        if (!opt.continuous) {
+            for (size_t i = 0; i < items.size(); ++i) finish_request(items[i], slots[i]);
+        }
+        output->flush();
+        if (!*output) throw std::runtime_error("failed while writing output");
+    }
+    if (!completed.empty() || requests != started) throw std::runtime_error("missing completed request output");
+    llama_synchronize(ctx.get());
+    const double wall_s = elapsed(work_start);
+    const auto perf = llama_perf_context(ctx.get());
+    const auto prefix_stats = llama_get_hymt_prefix_stats(ctx.get());
+    common_json width_counts = common_json::object();
+    for (const auto & entry : decode_width_counts) width_counts[std::to_string(entry.first)] = entry.second;
+    common_json summary = {
+        {"schema_version", 1}, {"engine", opt.continuous ? "hy-batch-continuous" : "hy-batch-fixed-wave"}, {"model", opt.model},
+        {"requests", requests}, {"waves", waves}, {"parallel", opt.parallel},
+        {"wave_widths", wave_widths}, {"final_wave_width", wave_widths.empty() ? 0 : wave_widths.back()},
+        {"pad_final_wave", opt.pad_final_wave}, {"pad_final_wave_effective", opt.pad_final_wave || opt.backend_sampling || opt.gpu_prefix},
+        {"context_per_sequence", opt.context}, {"max_tokens", opt.max_tokens},
+        {"batch", opt.batch}, {"ubatch", opt.ubatch}, {"seed", opt.seed}, {"greedy", opt.greedy},
+        {"sampling_threads", opt.sampling_threads},
+        {"batch_snapshot", batch_snapshot},
+        {"backend_sampling", opt.backend_sampling}, {"kv_unified", opt.kv_unified},
+        {"gpu_prefix", opt.gpu_prefix}, {"continuous", opt.continuous}, {"refill_min", opt.refill_min},
+        {"refill_events", refill_events}, {"refilled_requests", refilled_requests}, {"refill_prompt_ends", refill_prompt_ends},
+        {"decode_steps", decode_steps}, {"snapshot_wait_s", snapshot_wait_s}, {"cpu_sampling_s", cpu_sampling_s},
+        {"decode_width_counts", width_counts},
+        {"refill_prefill_s", refill_prefill_s},
+        {"gpu_prefix_stats", common_json({{"rows", prefix_stats.rows}, {"fallback_rows", prefix_stats.fallback_rows},
+                                          {"candidate_bytes", prefix_stats.candidate_bytes},
+                                          {"raw_logits_bytes", prefix_stats.raw_logits_bytes}})},
+        {"initialization_s", initialization_s}, {"wall_s", wall_s},
+        {"prompt_tokens", prompt_tokens}, {"completion_tokens", completion_tokens}, {"output_tokens", output_tokens},
+        {"completion_tokens_per_second", completion_tokens / wall_s},
+        {"output_tokens_per_second", output_tokens / wall_s}, {"translations_per_second", requests / wall_s},
+        {"decode_tokens_including_padding", decode_tokens}, {"dummy_decode_tokens", dummy_decode_tokens},
+        {"stopped", stopped}, {"truncated", truncated}, {"empty_outputs", empty},
+        {"graphs_reused", perf.n_reused}, {"repeat_penalty", 1.05}, {"repeat_last_n", 4096},
+        {"llama_perf", common_json({{"t_p_eval_ms", perf.t_p_eval_ms}, {"t_eval_ms", perf.t_eval_ms},
+                                   {"n_p_eval", perf.n_p_eval}, {"n_eval", perf.n_eval}})},
+        {"temperature", sampling.temp}, {"top_p", sampling.top_p}, {"top_k", sampling.top_k}, {"min_p", 0.0},
+        {"metric_notes", common_json::array({
+            "wall_s excludes model/context initialization and includes input reading, chat templates, tokenization, prefill, sampling, decode, and output writing.",
+            "completion_tokens counts sampled tokens including a terminal EOG token; output_tokens excludes EOG and all padding.",
+            "Within each wave, completed slots retain private dummy EOS tokens. Short CPU waves use their actual request count unless pad-final-wave is enabled.",
+            "Continuous mode refills free slots after sampling all previous outputs, clears only each replaced sequence, preserves global request order/seeds, and shrinks trailing idle slots after EOF.",
+            "wave_widths, final_wave_width and pad_final_wave_effective describe initial waves; decode_width_counts records actual decode widths after continuous EOF shrink.",
+            "In continuous mode, decode_tokens_including_padding also includes refill_prompt_ends. Separate refill prefill calls are not counted as decode tokens.",
+            "snapshot_wait_s includes GPU completion and output access, not pure CPU work. cpu_sampling_s times the prepared-snapshot sampler pool; refill_prefill_s includes replacement setup and synchronized prefix processing.",
+            "Backend and GPU prefix sampling retain the full wave width so all samplers referenced by cached graphs remain alive; pad_final_wave_effective records this fallback.",
+            "Request i uses seed + i, matching scripts/translate.py; each request has an independent sampler and full prompt penalty history.",
+            "No prompt prefix or KV cache is shared between requests. No warm-up is excluded from wall_s.",
+            "Parallel CPU sampling uses independent sampler chains and immutable snapshots; all context access and token acceptance remain on the main thread.",
+            "Batch snapshots synchronize/reorder once per generation step. LLAMA_HYMT_BATCH_SNAPSHOT=0 restores individual output access.",
+            "llama_perf reports upstream counters in milliseconds: more than one queued token counts as p_eval, including batched generation and padding; n_eval/n_p_eval are clamped to at least one upstream. These are not separate prompt/generation or pure GPU timings.",
+        })},
+    };
+    if (!opt.summary.empty()) {
+        std::ofstream file(std::filesystem::u8path(opt.summary), std::ios::binary);
+        if (!file || !(file << summary.dump(2) << '\n')) throw std::runtime_error("could not write summary file");
+    }
+    std::cerr << "hy-batch summary: " << summary.dump_safe() << '\n';
+    return truncated || empty ? 2 : 0;
+}
+
+} // namespace
+
+static int main_utf8(int argc, char ** argv) {
+    std::setlocale(LC_NUMERIC, "C");
+    for (int i = 1; i < argc; ++i) {
+        if (std::string(argv[i]) == "--help" || std::string(argv[i]) == "-h") {
+            usage();
+            return 0;
+        }
+    }
+    try {
+        return run(parse(argc, argv));
+    } catch (const std::exception & error) {
+        std::cerr << "hy-batch error: " << error.what() << '\n';
+        return 1;
+    }
+}
+
+#if defined(_WIN32)
+int wmain(int argc, wchar_t ** argv) {
+    try {
+        std::vector<std::string> arguments;
+        arguments.reserve(argc);
+        for (int i = 0; i < argc; ++i) {
+            const int size = WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, argv[i], -1, nullptr, 0, nullptr, nullptr);
+            if (size == 0) throw std::runtime_error("invalid Unicode command-line argument");
+            std::string argument(size, '\0');
+            if (WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, argv[i], -1, argument.data(), size, nullptr, nullptr) != size) {
+                throw std::runtime_error("could not convert command-line argument to UTF-8");
+            }
+            argument.pop_back(); // WideCharToMultiByte included the terminating NUL.
+            arguments.push_back(std::move(argument));
+        }
+        std::vector<char *> pointers;
+        pointers.reserve(size_t(argc) + 1);
+        for (auto & argument : arguments) pointers.push_back(argument.data());
+        pointers.push_back(nullptr);
+        return main_utf8(argc, pointers.data());
+    } catch (const std::exception & error) {
+        std::cerr << "hy-batch error: " << error.what() << '\n';
+        return 1;
+    }
+}
+#else
+int main(int argc, char ** argv) {
+    return main_utf8(argc, argv);
+}
+#endif
