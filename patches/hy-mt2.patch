+        else if (flag == "--input") result.input = value();
+        else if (flag == "--output") result.output = value();
+        else if (flag == "--summary") result.summary = value();
+        else if (flag == "--parallel" || flag == "-np") result.parallel = positive_integer(value(), flag);
+        else if (flag == "--context") result.context = positive_integer(value(), flag);
+        else if (flag == "--batch-size" || flag == "-b") result.batch = positive_integer(value(), flag);
+        else if (flag == "--ubatch-size" || flag == "-ub") result.ubatch = positive_integer(value(), flag);
+        else if (flag == "--max-tokens" || flag == "-n") result.max_tokens = positive_integer(value(), flag);
+        else if (flag == "--threads" || flag == "-t") result.threads = positive_integer(value(), flag);
+        else if (flag == "--sampling-threads") result.sampling_threads = positive_integer(value(), flag);
+        else if (flag == "--seed") {
+            const std::string text = value();
+            size_t used = 0;
+            const auto seed = std::stoull(text, &used);
+            if (used != text.size() || text.empty() || text[0] == '-' || seed >= LLAMA_DEFAULT_SEED) {
+                throw std::runtime_error("seed must be in 0..4294967294");
+            }
+            result.seed = uint32_t(seed);
+        } else if (flag == "--greedy") result.greedy = true;
+        else if (flag == "--backend-sampling") result.backend_sampling = true;
+        else if (flag == "--kv-unified") result.kv_unified = true;
+        else if (flag == "--pad-final-wave") result.pad_final_wave = true;
+        else if (flag == "--gpu-prefix") result.gpu_prefix = true;
+        else if (flag == "--continuous") result.continuous = true;
+        else if (flag == "--refill-min") result.refill_min = positive_integer(value(), flag);
+        else throw std::runtime_error("unknown option: " + flag);
+    }
+    if (result.model.empty()) throw std::runtime_error("--model is required");
+    if ((result.gpu_prefix && result.backend_sampling) ||
+        (result.continuous && (result.gpu_prefix || result.backend_sampling))) {
+        throw std::runtime_error("gpu-prefix, backend-sampling, and continuous are separate experimental paths");
+    }
+    if (result.refill_min > result.parallel) throw std::runtime_error("refill-min exceeds parallel");
+    if (result.parallel > 256 || result.parallel > result.ubatch || result.ubatch > result.batch) {
+        throw std::runtime_error("require 1 <= parallel <= 256 and parallel <= ubatch <= batch");
+    }
+    if (result.sampling_threads != 1 && result.sampling_threads != 2 &&
+        result.sampling_threads != 4 && result.sampling_threads != 8) {
+        throw std::runtime_error("sampling-threads must be 1, 2, 4, or 8");
+    }
+    const char * snapshot = std::getenv("LLAMA_HYMT_SAMPLING_SNAPSHOT");
+    if (result.sampling_threads > 1 && snapshot && std::string(snapshot) == "0") {
+        throw std::runtime_error("parallel sampling requires output snapshots; use sampling-threads 1 to disable snapshots");
+    }
+    if (result.context <= result.max_tokens || int64_t(result.context) * result.parallel > INT_MAX) {
+        throw std::runtime_error("context must exceed max-tokens and total context must fit int32");
+    }
+    const auto path = [](const std::string & name) {
+        return std::filesystem::absolute(std::filesystem::u8path(name)).lexically_normal();
+    };
+    const auto same_file = [&](const std::string & a, const std::string & b) {
+        std::error_code error;
+        return path(a) == path(b) || std::filesystem::equivalent(path(a), path(b), error);
+    };
+    if (result.input != "-" && result.output != "-" && same_file(result.input, result.output)) {
+        throw std::runtime_error("input and output must be different files");
+    }
+    if (!result.summary.empty() && ((result.input != "-" && same_file(result.input, result.summary)) ||
+                                   (result.output != "-" && same_file(result.output, result.summary)))) {
+        throw std::runtime_error("summary must be distinct from input and output");
+    }
+    return result;
+}
