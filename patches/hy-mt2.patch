diff --git a/ggml/src/ggml-cuda/hymt-penalties.cu b/ggml/src/ggml-cuda/hymt-penalties.cu
new file mode 100644
index 0000000000000000000000000000000000000000..11dccb78e89d3c421fff9fcef6936f9fc5ca4282
--- /dev/null
+++ b/ggml/src/ggml-cuda/hymt-penalties.cu
@@ -0,0 +1,55 @@
+#include "hymt-penalties.cuh"
+
+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+static __global__ void hymt_penalties_f32(
+        float * output, const int32_t * ids, const int32_t * counts,
+        const int64_t vocab, const int64_t history, const int64_t entries,
+        const float repeat, const float frequency, const float presence) {
+    const int64_t stride = int64_t(blockDim.x)*gridDim.x;
+    for (int64_t i = int64_t(blockIdx.x)*blockDim.x + threadIdx.x; i < entries; i += stride) {
+        const int32_t count = counts[i];
+        const int32_t id = ids[i];
+        if (count <= 0 || id < 0 || id >= vocab) {
+            continue;
+        }
+        const int64_t pos = (i/history)*vocab + id;
+        const float value = output[pos];
+        // The CPU sampler divides positive logits, rather than multiplying by
+        // a rounded reciprocal. Explicit operations also prevent FMA changes.
+        const float repeated = value <= 0.0f ? __fmul_rn(value, repeat) : __fdiv_rn(value, repeat);
+        const float penalty = __fadd_rn(__fmul_rn(__int2float_rn(count), frequency),
+                                       __fmul_rn(1.0f, presence));
+        output[pos] = __fsub_rn(repeated, penalty);
+    }
+}
+#endif
+
+void ggml_cuda_op_hymt_penalties(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+    const ggml_tensor * logits = dst->src[0];
+    const ggml_tensor * ids = dst->src[1];
+    const ggml_tensor * counts = dst->src[2];
+    GGML_ASSERT(logits->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ids->type == GGML_TYPE_I32 && counts->type == GGML_TYPE_I32);
+    GGML_ASSERT(ggml_is_contiguous(logits) && ggml_is_contiguous(ids) &&
+                ggml_is_contiguous(counts) && ggml_is_contiguous(dst));
+    GGML_ASSERT(ggml_is_matrix(logits) && ggml_is_matrix(ids) && ggml_are_same_shape(ids, counts));
+    GGML_ASSERT(logits->ne[1] == ids->ne[1] && ggml_are_same_shape(logits, dst));
+
+    float penalties[3];
+    memcpy(penalties, dst->op_params, sizeof(penalties));
+    const int64_t entries = ggml_nelements(ids);
+    const int blocks = (int) std::min<int64_t>((entries + 255)/256, 65535);
+    // Preserve raw model logits for unsupported or exceptional-row fallback.
+    // The following sparse updates are ordered after this copy on one stream.
+    CUDA_CHECK(cudaMemcpyAsync(dst->data, logits->data, ggml_nbytes(logits), cudaMemcpyDeviceToDevice, ctx.stream()));
+    hymt_penalties_f32<<<blocks, 256, 0, ctx.stream()>>>(
+        (float *) dst->data, (const int32_t *) ids->data, (const int32_t *) counts->data,
+        logits->ne[0], ids->ne[0], entries, penalties[0], penalties[1], penalties[2]);
+    CUDA_CHECK(cudaGetLastError());
+#else
+    GGML_UNUSED(ctx);
+    GGML_UNUSED(dst);
+    GGML_ABORT("HYMT_PENALTIES strict GPU implementation requires CUDA");
+#endif
+}
