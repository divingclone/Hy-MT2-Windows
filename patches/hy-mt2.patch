+static __global__ void hymt_top_k_merge(const float * values, const int * indices, int * dst, const int k) {
+    using sorter = cub::BlockRadixSort<float, 256, 16, int>;
+    __shared__ typename sorter::TempStorage storage;
+    constexpr int count = HYMT_TOP_K_TILES * HYMT_TOP_K_KEEP;
+    const int row = blockIdx.x;
+    float keys[16];
+    int ids[16];
+#pragma unroll
+    for (int i = 0; i < 16; ++i) {
+        const int col = threadIdx.x * 16 + i;
+        keys[i] = col < count ? values[int64_t(row) * count + col] : -INFINITY;
+        ids[i] = col < count ? indices[int64_t(row) * count + col] : INT_MAX;
+    }
+    sorter(storage).SortDescendingBlockedToStriped(keys, ids);
+    if (threadIdx.x < k) {
+        dst[int64_t(row) * k + threadIdx.x] = ids[0];
+    }
+}
