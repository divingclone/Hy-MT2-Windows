+// GGML_OP_HYMT_PENALTIES: exact F32 CPU/GPU comparison, plus an independent
+// scalar reference and verification that raw model logits remain unchanged.
+struct test_hymt_penalties : public test_case {
+    const int64_t vocab;
+    const int64_t batch;
+    const int64_t history;
+    const float repeat;
+    const float frequency;
+    const float presence;
+    ggml_tensor * logits = nullptr;
+    ggml_tensor * ids = nullptr;
+    ggml_tensor * counts = nullptr;
+    std::vector<float> original;
+    std::vector<float> expected;
+
+    test_hymt_penalties(int64_t vocab, int64_t batch, int64_t history,
+                       float repeat, float frequency, float presence)
+        : vocab(vocab), batch(batch), history(history), repeat(repeat), frequency(frequency), presence(presence) {}
+
+    std::string vars() override {
+        return VARS_TO_STR6(vocab, batch, history, repeat, frequency, presence);
+    }
+
+    bool run_whole_graph() override { return true; }
+    double max_nmse_err() override { return 0.0; }
+
+    double err(const float * a, const float * b, size_t n) override {
+        if (n != expected.size() || memcmp(a, b, n*sizeof(float)) != 0 ||
+            memcmp(a, expected.data(), n*sizeof(float)) != 0) {
+            return 1.0;
+        }
+        std::vector<float> after(original.size());
+        ggml_backend_tensor_get(logits, after.data(), 0, after.size()*sizeof(float));
+        return memcmp(after.data(), original.data(), after.size()*sizeof(float)) == 0 ? 0.0 : 1.0;
+    }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        logits = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, vocab, batch);
+        ids = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, history, batch);
+        counts = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, history, batch);
+        ggml_set_name(logits, "logits");
+        ggml_set_name(ids, "history_ids");
+        ggml_set_name(counts, "history_counts");
+        ggml_set_input(logits);
+        ggml_set_input(ids);
+        ggml_set_input(counts);
+        return ggml_hymt_penalties(ctx, logits, ids, counts, repeat, frequency, presence);
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        test_case::initialize_tensors(ctx);
+        original.resize(vocab*batch);
+        // Include signed zero, masked scores, normal/subnormal boundaries, and
+        // positive divisions for which multiplication by 1/repeat can differ.
+        const float special[] = {
+            0.0f, -0.0f, INFINITY, -INFINITY, 1.0f, -1.0f, 3.1415927f, -3.1415927f,
+            FLT_MIN, -FLT_MIN, std::nextafter(FLT_MIN, 0.0f), std::nextafter(0.0f, 1.0f),
+        };
+        for (int64_t row = 0; row < batch; ++row) {
+            for (int64_t col = 0; col < vocab; ++col) {
+                original[row*vocab + col] = col < int64_t(sizeof(special)/sizeof(*special)) ? special[col] :
+                    float(((col*157 + row*29) % 2047) - 1023)*0.01953125f;
+            }
+        }
+        std::vector<int32_t> id_data(history*batch, 0);
+        std::vector<int32_t> count_data(history*batch, 0);
+        expected = original;
+        for (int64_t row = 0; row < batch; ++row) {
+            // Every third row has an entirely empty independent history.
+            const int64_t active = row % 3 == 1 ? 0 : std::min(vocab, history > 4 ? history - 4 : history);
+            for (int64_t i = 0; i < active; ++i) {
+                const int32_t id = int32_t((i + row*37) % vocab);
+                const int32_t count = i % 17 == 16 ? 16777217 : int32_t(1 + (i*13 + row*7) % 4096);
+                id_data[row*history + i] = id;
+                count_data[row*history + i] = count;
+                const float value = expected[row*vocab + id];
+                volatile float repeated = value <= 0.0f ? value*repeat : value/repeat;
+                volatile float freq = float(count)*frequency;
+                volatile float pres = float(count > 0)*presence;
+                volatile float combined = freq + pres;
+                expected[row*vocab + id] = repeated - combined;
+            }
+            if (history > 4) {
+                // Zero-count duplicate padding must never overwrite a valid
+                // token. Invalid positive IDs and negative counts are ignored.
+                id_data[row*history + history - 4] = int32_t((row*37) % vocab);
+                id_data[row*history + history - 3] = -1;
+                count_data[row*history + history - 3] = 2;
+                id_data[row*history + history - 2] = int32_t(vocab);
+                count_data[row*history + history - 2] = 3;
+                id_data[row*history + history - 1] = int32_t((row*37) % vocab);
+                count_data[row*history + history - 1] = -1;
+            }
+        }
+        ggml_backend_tensor_set(logits, original.data(), 0, original.size()*sizeof(float));
+        ggml_backend_tensor_set(ids, id_data.data(), 0, id_data.size()*sizeof(int32_t));
+        ggml_backend_tensor_set(counts, count_data.data(), 0, count_data.size()*sizeof(int32_t));
+    }
+};
