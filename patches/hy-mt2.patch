+// Guarded Hy-MT GPU prefix. Interface identity avoids unsafe casts based on names.
+static bool llama_sampler_hymt_prefix_config(const llama_sampler * sampler, llama_sampler_hymt_prefix & config) {
+    if (!sampler || sampler->iface != &llama_sampler_chain_i) return false;
+    const auto * chain = (const llama_sampler_chain *) sampler->ctx;
+    config = {};
+    bool has_penalties = false, has_top_k = false, has_dist = false;
+    for (size_t i = 0; i < chain->samplers.size(); ++i) {
+        const auto * child = chain->samplers[i].ptr;
+        if (child->iface == &llama_sampler_empty_i) continue;
+        if (!has_top_k) {
+            if (!has_penalties && child->iface == &llama_sampler_penalties_i) {
+                const auto * penalties = (const llama_sampler_penalties *) child->ctx;
+                if (penalties->n_vocab != 120818 || penalties->penalty_last_n < 1 ||
+                        penalties->penalty_last_n > 4096 ||
+                        !std::isfinite(penalties->penalty_repeat) || penalties->penalty_repeat <= 0.0f ||
+                        !std::isfinite(penalties->penalty_freq) || !std::isfinite(penalties->penalty_present)) return false;
+                config.history = penalties->penalty_last_n;
+                config.repeat = penalties->penalty_repeat;
+                config.frequency = penalties->penalty_freq;
+                config.present = penalties->penalty_present;
+                has_penalties = true;
+            } else if (has_penalties && child->iface == &llama_sampler_top_k_i) {
+                config.k = ((const llama_sampler_top_k *) child->ctx)->k;
+                // One extra item detects a boundary tie without losing CPU candidates.
+                if (config.k < 1 || config.k >= 32) return false;
+                config.prefix_count = uint32_t(i + 1);
+                has_top_k = true;
+            } else return false;
+        } else if (child->iface == &llama_sampler_dist_i && i + 1 == chain->samplers.size()) {
+            has_dist = true;
+        } else if (child->iface != &llama_sampler_top_p_i &&
+                   child->iface != &llama_sampler_temp_i && child->iface != &llama_sampler_temp_ext_i) return false;
+    }
+    return has_penalties && has_top_k && has_dist;
+}
+
+bool llama_sampler_enable_hymt_gpu_prefix(llama_sampler * sampler) {
+    llama_sampler_hymt_prefix config;
+    if (!llama_sampler_hymt_prefix_config(sampler, config)) return false;
+    auto * chain = (llama_sampler_chain *) sampler->ctx;
+    if (chain->is_init) return false;
+    chain->hymt_prefix_requested = true;
+    return true;
+}
+
+bool llama_sampler_hymt_prefix_get(const llama_sampler * sampler, llama_sampler_hymt_prefix & config) {
+    if (!sampler || sampler->iface != &llama_sampler_chain_i) return false;
+    const auto * chain = (const llama_sampler_chain *) sampler->ctx;
+    return chain->hymt_prefix_requested && chain->hymt_prefix_backend &&
+           llama_sampler_hymt_prefix_config(sampler, config);
+}
+
+bool llama_sampler_hymt_prefix_fill(const llama_sampler * sampler, int32_t * ids, int32_t * counts, int32_t capacity) {
+    llama_sampler_hymt_prefix config;
+    if (!ids || !counts || !llama_sampler_hymt_prefix_get(sampler, config) || capacity != config.history) return false;
+    std::fill_n(ids, capacity, 0);
+    std::fill_n(counts, capacity, 0);
+    const auto * chain = (const llama_sampler_chain *) sampler->ctx;
+    for (const auto & entry : chain->samplers) {
+        if (entry.ptr->iface != &llama_sampler_penalties_i) continue;
+        const auto * penalties = (const llama_sampler_penalties *) entry.ptr->ctx;
+        if (penalties->token_count.size() > size_t(capacity)) return false;
+        size_t index = 0;
+        for (const auto & item : penalties->token_count) {
+            if (item.first < 0 || item.first >= 120818 || item.second < 1 || item.second > capacity) return false;
+            ids[index] = item.first;
+            counts[index++] = item.second;
+        }
+        return true;
+    }
+    return false;
+}
+
+void llama_sampler_apply_hymt_gpu_tail(llama_sampler * sampler, llama_token_data_array * candidates) {
+    llama_sampler_hymt_prefix config;
+    if (!candidates || !llama_sampler_hymt_prefix_get(sampler, config) || candidates->size != size_t(config.k)) {
+        GGML_ABORT("invalid Hy-MT GPU prefix result or sampler");
+    }
+    auto * chain = (llama_sampler_chain *) sampler->ctx;
+    time_meas tm(chain->t_sample_us, chain->params.no_perf);
+    for (size_t i = config.prefix_count; i < chain->samplers.size(); ++i) {
+        llama_sampler_apply(chain->samplers[i].ptr, candidates);
+    }
+}
