diff --git a/tests/test-hymt-prefix.cpp b/tests/test-hymt-prefix.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3ac34d90f333e1e3bd8b43bd786eec0eb57ea5a1
--- /dev/null
+++ b/tests/test-hymt-prefix.cpp
@@ -0,0 +1,269 @@
+#include "llama.h"
+#include "llama-sampler.h"
+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <deque>
+#include <limits>
+#include <map>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+constexpr int V = 120818;
+constexpr int K = 20;
+constexpr int H = 8;
+using sampler_ptr = std::unique_ptr<llama_sampler, decltype(&llama_sampler_free)>;
+
+void require(bool value, const char * message) {
+    if (!value) throw std::runtime_error(message);
+}
+
+bool same_float(float a, float b) {
+    return std::memcmp(&a, &b, sizeof(float)) == 0;
+}
+
+sampler_ptr make_chain(float repeat, float frequency, float present, uint32_t seed) {
+    sampler_ptr chain(llama_sampler_chain_init(llama_sampler_chain_default_params()), llama_sampler_free);
+    llama_sampler_chain_add(chain.get(), llama_sampler_init_penalties(V, H, repeat, frequency, present));
+    llama_sampler_chain_add(chain.get(), llama_sampler_init_top_k(K));
+    llama_sampler_chain_add(chain.get(), llama_sampler_init_top_p(0.6f, 1));
+    llama_sampler_chain_add(chain.get(), llama_sampler_init_temp(0.7f));
+    llama_sampler_chain_add(chain.get(), llama_sampler_init_dist(seed));
+    return chain;
+}
+
+void test_guard() {
+    float values[] = { 3, 2, 1 };
+    int32_t ids[] = { 7, 5, 9 };
+    require(llama_sampler_hymt_prefix_candidates_valid(values, ids, 3, V), "finite prefix rejected");
+    values[1] = 3;
+    require(!llama_sampler_hymt_prefix_candidates_valid(values, ids, 3, V), "internal tie accepted");
+    values[1] = 2; values[2] = 2;
+    require(!llama_sampler_hymt_prefix_candidates_valid(values, ids, 3, V), "boundary tie accepted");
+    values[2] = 1; ids[2] = V;
+    require(!llama_sampler_hymt_prefix_candidates_valid(values, ids, 3, V), "invalid ID accepted");
+    ids[2] = 9;
+    for (float exceptional : { std::numeric_limits<float>::infinity(),
+                              -std::numeric_limits<float>::infinity(),
+                              std::numeric_limits<float>::quiet_NaN(),
+                              -std::numeric_limits<float>::quiet_NaN() }) {
+        values[0] = exceptional;
+        require(!llama_sampler_hymt_prefix_candidates_valid(values, ids, 3, V), "nonfinite prefix accepted");
+    }
+    require(!llama_sampler_hymt_prefix_candidates_valid(nullptr, ids, 3, V), "null prefix accepted");
+}
+
+struct fixture {
+    ggml_backend_t backend;
+    ggml_context * ctx = nullptr;
+    ggml_backend_buffer_t buffer = nullptr;
+    ggml_cgraph * graph = nullptr;
+    ggml_tensor * raw = nullptr;
+    ggml_tensor * ids = nullptr;
+    ggml_tensor * counts = nullptr;
+    ggml_tensor * top_ids = nullptr;
+    ggml_tensor * top_values = nullptr;
+    int rows;
+    std::vector<float> logits, values;
+    std::vector<int32_t> history_ids, history_counts, candidates;
+    std::vector<sampler_ptr> reference, prefix;
+    std::vector<std::deque<llama_token>> history;
+    size_t accepted_rows = 0, fallback_rows = 0;
+
+    fixture(ggml_backend_t backend_, int rows_, float repeat, float frequency, float present)
+        : backend(backend_), rows(rows_), logits(size_t(V) * rows), values(size_t(K + 1) * rows),
+          history_ids(size_t(H) * rows), history_counts(size_t(H) * rows),
+          candidates(size_t(K + 1) * rows), history(rows) {
+        ggml_init_params params = { ggml_tensor_overhead() * 128 + ggml_graph_overhead(), nullptr, true };
+        ctx = ggml_init(params);
+        require(ctx != nullptr, "ggml_init failed");
+        raw = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, V, rows);
+        ids = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, H, rows);
+        counts = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, H, rows);
+        auto * penalized = ggml_hymt_penalties(ctx, raw, ids, counts, repeat, frequency, present);
+        top_ids = ggml_top_k(ctx, penalized, K + 1);
+        top_values = ggml_reshape_2d(ctx,
+                ggml_get_rows(ctx, ggml_reshape_3d(ctx, penalized, 1, V, rows), top_ids), K + 1, rows);
+        ggml_set_input(raw); ggml_set_input(ids); ggml_set_input(counts);
+        ggml_set_output(raw); ggml_set_output(top_ids); ggml_set_output(top_values);
+        require(ggml_backend_supports_op(backend, penalized), "backend lacks strict penalties");
+        require(ggml_backend_supports_op(backend, top_ids), "backend lacks TopK");
+        graph = ggml_new_graph(ctx);
+        ggml_build_forward_expand(graph, top_values);
+        buffer = ggml_backend_alloc_ctx_tensors(ctx, backend);
+        require(buffer != nullptr, "graph allocation failed");
+        for (int row = 0; row < rows; ++row) {
+            reference.push_back(make_chain(repeat, frequency, present, 42 + row));
+            prefix.push_back(make_chain(repeat, frequency, present, 42 + row));
+            require(llama_sampler_enable_hymt_gpu_prefix(prefix.back().get()), "eligible chain rejected");
+            auto * sampler = prefix.back().get();
+            require(sampler->iface->backend_init(sampler, ggml_backend_get_default_buffer_type(backend), 1),
+                    "prefix backend initialization rejected (CUDA Hy-MT TopK must be enabled)");
+        }
+    }
+
+    ~fixture() {
+        if (buffer) ggml_backend_buffer_free(buffer);
+        if (ctx) ggml_free(ctx);
+    }
+
+    void fill(int step) {
+        for (int row = 0; row < rows; ++row) {
+            float * dst = logits.data() + size_t(row) * V;
+            for (int token = 0; token < V; ++token) dst[token] = -200.0f - token * 0.001f;
+            for (int token = 0; token < 32; ++token) {
+                dst[500 + token] = 10.0f - token * 0.03125f + (step + row) * 0.0009765625f;
+            }
+            dst[600] = -1.0f; // Negative repeated value exercises the multiply branch.
+        }
+    }
+
+    void compute() {
+        std::fill(history_ids.begin(), history_ids.end(), 0);
+        std::fill(history_counts.begin(), history_counts.end(), 0);
+        for (int row = 0; row < rows; ++row) {
+            std::map<llama_token, int32_t> frequencies;
+            for (llama_token token : history[row]) ++frequencies[token];
+            size_t i = size_t(row) * H;
+            for (const auto & entry : frequencies) {
+                history_ids[i] = entry.first;
+                history_counts[i++] = entry.second;
+            }
+        }
+        ggml_backend_tensor_set(raw, logits.data(), 0, logits.size() * sizeof(float));
+        ggml_backend_tensor_set(ids, history_ids.data(), 0, history_ids.size() * sizeof(int32_t));
+        ggml_backend_tensor_set(counts, history_counts.data(), 0, history_counts.size() * sizeof(int32_t));
+        require(ggml_backend_graph_compute(backend, graph) == GGML_STATUS_SUCCESS, "prefix graph failed");
+        ggml_backend_tensor_get(top_values, values.data(), 0, values.size() * sizeof(float));
+        ggml_backend_tensor_get(top_ids, candidates.data(), 0, candidates.size() * sizeof(int32_t));
+        std::vector<float> preserved(logits.size());
+        ggml_backend_tensor_get(raw, preserved.data(), 0, preserved.size() * sizeof(float));
+        require(std::memcmp(logits.data(), preserved.data(), logits.size() * sizeof(float)) == 0,
+                "GPU prefix modified raw logits needed for fallback");
+    }
+
+    bool valid(int row) const {
+        return llama_sampler_hymt_prefix_candidates_valid(values.data() + size_t(row) * (K + 1),
+                candidates.data() + size_t(row) * (K + 1), K + 1, V);
+    }
+
+    void accept(int row, llama_token token) {
+        llama_sampler_accept(reference[row].get(), token);
+        llama_sampler_accept(prefix[row].get(), token);
+        history[row].push_back(token);
+        if (history[row].size() > H) history[row].pop_front();
+    }
+
+    void compare(int row) {
+        std::vector<llama_token_data> full(V), reduced;
+        for (int token = 0; token < V; ++token) full[token] = { token, logits[size_t(row) * V + token], 0 };
+        const bool use_prefix = valid(row);
+        if (use_prefix) {
+            for (int i = 0; i < K; ++i) {
+                const size_t index = size_t(row) * (K + 1) + i;
+                reduced.push_back({ candidates[index], values[index], 0 });
+            }
+            ++accepted_rows;
+        } else {
+            reduced = full;
+            ++fallback_rows;
+        }
+        llama_output_snapshot snapshot = {};
+        snapshot.n_vocab = V;
+        snapshot.hymt_gpu_prefix = use_prefix;
+        // The production guard controls the metadata that chooses CPU tail vs full chain.
+        llama_token_data_array expected = { full.data(), full.size(), -1, false };
+        llama_token_data_array actual = { reduced.data(), reduced.size(), -1, snapshot.hymt_gpu_prefix };
+        llama_sampler_apply(reference[row].get(), &expected);
+        if (snapshot.hymt_gpu_prefix) llama_sampler_apply_hymt_gpu_tail(prefix[row].get(), &actual);
+        else llama_sampler_apply(prefix[row].get(), &actual);
+        require(actual.size == expected.size, "candidate count mismatch");
+        require(actual.selected == expected.selected, "selected index/RNG mismatch");
+        for (size_t i = 0; i < actual.size; ++i) {
+            require(actual.data[i].id == expected.data[i].id, "candidate ID/order mismatch");
+            require(same_float(actual.data[i].logit, expected.data[i].logit), "candidate logit mismatch");
+            require(same_float(actual.data[i].p, expected.data[i].p), "candidate probability mismatch");
+        }
+        require(actual.selected >= 0, "no sampled token");
+        accept(row, actual.data[actual.selected].id);
+    }
+
+    void reset() {
+        for (int row = 0; row < rows; ++row) {
+            llama_sampler_reset(reference[row].get());
+            llama_sampler_reset(prefix[row].get());
+            history[row].clear();
+        }
+    }
+};
+
+void test_backend(ggml_backend_t backend, int rows, float repeat, float frequency, float present) {
+    fixture f(backend, rows, repeat, frequency, present);
+    for (int step = 0; step < 24; ++step) {
+        f.fill(step);
+        f.compute();
+        for (int row = 0; row < rows; ++row) {
+            f.compare(row);
+            if (step % 3 == 0) f.accept(row, 600);
+        }
+    }
+    require(f.accepted_rows > 0, "all rows unexpectedly fell back");
+    for (int tie : { 1, K }) {
+        f.reset(); f.fill(0);
+        for (int row = 0; row < rows; ++row) {
+            float * raw = f.logits.data() + size_t(row) * V;
+            raw[500 + tie] = raw[500 + tie - 1];
+        }
+        f.compute();
+        for (int row = 0; row < rows; ++row) {
+            require(!f.valid(row), "GPU internal/boundary tie failed to trigger fallback");
+            f.compare(row); // Full CPU path preserves tie order and consumes one RNG draw.
+        }
+        f.fill(1); f.compute();
+        for (int row = 0; row < rows; ++row) f.compare(row); // Subsequent RNG state must still match.
+    }
+    for (float nan : { std::numeric_limits<float>::quiet_NaN(), -std::numeric_limits<float>::quiet_NaN() }) {
+        f.reset(); f.fill(0);
+        for (int row = 0; row < rows; ++row) f.logits[size_t(row) * V + V - 1] = nan;
+        f.compute();
+        for (int row = 0; row < rows; ++row) require(!f.valid(row), "raw NaN escaped prefix fallback");
+        // No reference distribution is asserted for NaN logits: sampling is undefined there.
+    }
+    std::printf("PASS rows=%d repeat=%g frequency=%g present=%g prefix=%zu fallback=%zu\n",
+            rows, repeat, frequency, present, f.accepted_rows, f.fallback_rows);
+}
+} // namespace
+
+int main(int argc, char ** argv) {
+    ggml_backend_t backend = nullptr;
+    try {
+        test_guard();
+        if (argc == 2 && std::string(argv[1]) == "--guard-only") {
+            std::puts("PASS CPU candidate guard");
+            return 0;
+        }
+        ggml_backend_load_all();
+        const char * name = argc > 1 ? argv[1] : "CUDA0";
+        backend = ggml_backend_init_by_name(name, nullptr);
+        require(backend != nullptr, "requested backend unavailable");
+        test_backend(backend, 1, 1.05f, 0.0f, 0.0f);
+        test_backend(backend, 4, 1.05f, 0.0f, 0.0f);
+        test_backend(backend, 4, 1.125f, 0.0625f, -0.03125f);
+        test_backend(backend, 4, 0.875f, -0.0625f, 0.03125f);
+        ggml_backend_free(backend);
+        std::puts("PASS Hy-MT GPU prefix: exact candidates, probabilities, multi-step RNG, tie/NaN fallback");
+        return 0;
+    } catch (const std::exception & error) {
+        if (backend) ggml_backend_free(backend);
+        std::fprintf(stderr, "FAIL: %s\n", error.what());
+        return 1;
+    }
+}
