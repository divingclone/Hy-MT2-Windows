+static __global__ void hymt_top_k_tiles(const float * src, float * values, int * indices) {
+    using sorter = cub::BlockRadixSort<float, 256, 4, int>;
+    __shared__ typename sorter::TempStorage storage;
+    const int tile = blockIdx.x;
+    const int row = blockIdx.y;
+    float keys[4];
+    int ids[4];
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        const int col = tile * HYMT_TOP_K_TILE + threadIdx.x * 4 + i;
+        keys[i] = col < HYMT_TOP_K_COLS ? src[int64_t(row) * HYMT_TOP_K_COLS + col] : -INFINITY;
+        // Surface either-sign NaN to the prefix's CPU fallback check. Only the
+        // sorting key changes: the ID still gathers the original NaN logit.
+        // Bit inspection is reliable even with this TU's fast-math settings.
+        if ((__float_as_uint(keys[i]) & 0x7fffffffU) > 0x7f800000U) {
+            keys[i] = INFINITY;
+        }
+        ids[i] = col;
+    }
+    // Stable sorting keeps lower token IDs first when logit values are equal.
+    sorter(storage).SortDescendingBlockedToStriped(keys, ids);
+    if (threadIdx.x < HYMT_TOP_K_KEEP) {
+        const int64_t dst = (int64_t(row) * HYMT_TOP_K_TILES + tile) * HYMT_TOP_K_KEEP + threadIdx.x;
+        values[dst] = keys[0];
+        indices[dst] = ids[0];
+    }
+}
