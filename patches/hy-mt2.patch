+static void hymt_top_k_cuda(ggml_cuda_pool & pool, const float * src, int * dst, const int nrows,
+                           const int k, cudaStream_t stream) {
+    const int64_t count = int64_t(nrows) * HYMT_TOP_K_TILES * HYMT_TOP_K_KEEP;
