+// ggml_compute_forward_hymt_penalties
+
+void ggml_compute_forward_hymt_penalties(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * logits = dst->src[0];
+    const ggml_tensor * ids = dst->src[1];
+    const ggml_tensor * counts = dst->src[2];
+    GGML_ASSERT(logits->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ids->type == GGML_TYPE_I32 && counts->type == GGML_TYPE_I32);
+    GGML_ASSERT(ggml_is_contiguous(logits) && ggml_is_contiguous(ids) &&
+                ggml_is_contiguous(counts) && ggml_is_contiguous(dst));
+
+    float penalties[3];
+    memcpy(penalties, dst->op_params, sizeof(penalties));
+    const int64_t vocab = logits->ne[0];
+    const int64_t history = ids->ne[0];
+    // A worker owns a complete row, including the copy, so no scatter races or
+    // cross-thread barrier are needed. Positive-count IDs are unique per row.
+    for (int64_t row = params->ith; row < logits->ne[1]; row += params->nth) {
+        float * output = (float *) dst->data + row*vocab;
+        memcpy(output, (const float *) logits->data + row*vocab, vocab*sizeof(float));
+        const int32_t * row_ids = (const int32_t *) ids->data + row*history;
+        const int32_t * row_counts = (const int32_t *) counts->data + row*history;
+        for (int64_t i = 0; i < history; ++i) {
+            const int32_t id = row_ids[i];
+            const int32_t count = row_counts[i];
+            if (count <= 0 || id < 0 || id >= vocab) {
+                continue;
+            }
+            const float value = output[id];
+            // Volatile intermediates enforce the individual float roundings
+            // used by the Windows CPU sampler, including separate mul/add/sub.
+            volatile float repeated = value <= 0.0f ? value*penalties[0] : value/penalties[0];
+            volatile float frequency = float(count)*penalties[1];
+            volatile float presence = float(count > 0)*penalties[2];
+            volatile float combined = frequency + presence;
+            output[id] = repeated - combined;
+        }
+    }
+}
