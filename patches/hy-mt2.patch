+// Only sampler-local work runs here. The caller owns every context operation and
+// does not modify borrowed output buffers until run() has joined the whole step.
+class sampling_pool {
+public:
+    explicit sampling_pool(int threads) {
+        if (threads == 1) return;
+        try {
+            for (int i = 0; i < threads; ++i) workers.emplace_back([this] { worker(); });
+        } catch (...) {
+            stop();
+            throw;
+        }
+    }
+
+    ~sampling_pool() { stop(); }
+    sampling_pool(const sampling_pool &) = delete;
+    sampling_pool & operator=(const sampling_pool &) = delete;
+
+    void run(size_t count, std::function<void(size_t)> task) {
+        if (workers.empty() || count < 2) {
+            for (size_t i = 0; i < count; ++i) task(i);
+            return;
+        }
+        std::unique_lock<std::mutex> lock(mutex);
+        job = std::move(task);
+        jobs = count;
+        next.store(0, std::memory_order_relaxed);
+        pending = workers.size();
+        failure = nullptr;
+        ++generation;
+        ready.notify_all();
+        done.wait(lock, [this] { return pending == 0; });
+        job = {};
+        if (failure) std::rethrow_exception(failure);
+    }
+
+private:
+    void stop() {
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            stopping = true;
+        }
+        ready.notify_all();
+        for (auto & thread : workers) thread.join();
+    }
+
+    void worker() {
+        uint64_t seen = 0;
+        std::unique_lock<std::mutex> lock(mutex);
+        while (true) {
+            ready.wait(lock, [this, seen] { return stopping || generation != seen; });
+            if (stopping) return;
+            seen = generation;
+            lock.unlock();
+            try {
+                while (true) {
+                    const size_t index = next.fetch_add(1, std::memory_order_relaxed);
+                    if (index >= jobs) break;
+                    job(index);
+                }
+            } catch (...) {
+                std::lock_guard<std::mutex> error_lock(mutex);
+                if (!failure) failure = std::current_exception();
+            }
+            lock.lock();
+            if (--pending == 0) done.notify_one();
+        }
+    }
+
+    std::vector<std::thread> workers;
+    std::mutex mutex;
+    std::condition_variable ready, done;
+    std::function<void(size_t)> job;
+    std::exception_ptr failure;
+    std::atomic<size_t> next{0};
+    size_t jobs = 0, pending = 0;
+    uint64_t generation = 0;
+    bool stopping = false;
+};
