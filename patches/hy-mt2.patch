+    GGML_ASSERT(ggml_is_matrix(logits) && ggml_is_matrix(ids) && ggml_is_matrix(counts));
+    GGML_ASSERT(ggml_is_contiguous(logits) && ggml_is_contiguous(ids) && ggml_is_contiguous(counts));
