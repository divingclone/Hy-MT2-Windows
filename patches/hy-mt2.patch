+// partial_sort behavior: the bad token must be selected for fallback inspection.
+struct test_hymt_top_k_nan : public test_case {
+    const int k;
+    ggml_tensor * input = nullptr;
+    const std::array<int32_t, 4> bad_ids = {0, 1023, 1024, 120817};
+
+    explicit test_hymt_top_k_nan(int k) : k(k) {}
+    std::string op_desc(ggml_tensor *) override { return "HYMT_TOP_K_NAN"; }
+    std::string vars() override { return VARS_TO_STR1(k); }
+    bool run_whole_graph() override { return true; }
+    double max_nmse_err() override { return 0.0; }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        input = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 120818, 4);
+        return ggml_top_k(ctx, input, k);
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        test_case::initialize_tensors(ctx);
+        std::vector<float> data(120818*4);
+        for (size_t row = 0; row < bad_ids.size(); ++row) {
+            for (int32_t col = 0; col < 120818; ++col) data[row*120818 + col] = float(col);
+            const uint32_t bits = row % 2 == 0 ? 0x7fc00001U : 0xffc00001U;
+            memcpy(&data[row*120818 + bad_ids[row]], &bits, sizeof(bits));
+        }
+        ggml_backend_tensor_set(input, data.data(), 0, data.size()*sizeof(float));
+    }
+
+    double err(const float * a, const float *, size_t count) override {
+        if (count != size_t(k)*bad_ids.size()) return 1.0;
+        for (size_t row = 0; row < bad_ids.size(); ++row) {
+            if (a[row*k] != float(bad_ids[row])) return 1.0;
+            int32_t next = 120817;
+            for (int i = 1; i < k; ++i) {
+                if (next == bad_ids[row]) --next;
+                if (a[row*k + i] != float(next--)) return 1.0;
+            }
+        }
+        return 0.0;
+    }
+};
