# Local runtimes, generated sources, build products and experiments
/.local/
/.venv/
/bin/
/build/
/runtime/
/src/
/dist/
/results/
/cache/
/downloads/
/models/*
!/models/manifest.json
!/models/README.md

# Model/binary files never belong in the source repository
*.gguf
*.safetensors
*.exe
*.dll
*.pdb
*.obj
*.lib
*.zip
*.7z
*.log
__pycache__/
*.egg-info/
*.py[cod]
.pytest_cache/
.env
.env.*
!.env.example
*token*
!scripts/*
/examples/*output*
/examples/*.translated.*

# Editor / OS files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Desktop dependencies, staged runtime and build outputs
/desktop/node_modules/
/desktop/dist/
/desktop/src-tauri/target/
/desktop/src-tauri/gen/
/desktop/src-tauri/resources/payload/*
!/desktop/src-tauri/resources/payload/.gitkeep
/desktop/src-tauri/tauri.release.conf.json
*.key
*.key.pub
